{
  "name": "wishbox/pkg-wishboxmodulbank",
  "description": "Joomla integration with ModulBank",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.5",
    "ext-curl": "*"
  },
  "require-dev": {
    "joomla/registry": "^3.0",
    "nyholm/psr7": "^1.8",
    "php-http/curl-client": "^2.3",
    "phpunit/phpunit": "^12.5",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "WishboxModulBankLibrary\\": "lib_wishboxmodulbank/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "civicrm/composer-compile-plugin": false,
      "php-http/discovery": false
    }
  }
}
